+import { Type } from '@sinclair/typebox'
+import type { FastifyPluginAsyncTypebox } from '@fastify/type-provider-typebox'
+import { AppError, ForbiddenError, NotFoundError } from '../errors.js'
+import { findUserById, updateUser } from '../repositories/user-repository.js'
+
+const User = Type.Object({
+  id: Type.String({ format: 'uuid' }),
+  name: Type.String(),
+  email: Type.String({ format: 'email' }),
+  createdAt: Type.String({ format: 'date-time' })
+})
+
+const UNIQUE_VIOLATION = '23505'
+
+export const userRoutes: FastifyPluginAsyncTypebox = async (app) => {
+  app.get(
+    '/:id',
+    {
+      schema: {
+        params: Type.Object({ id: Type.String({ format: 'uuid' }) }),
+        response: { 200: User }
+      }
+    },
+    async (request) => {
+      const user = await findUserById(app.db, request.auth.companyId, request.params.id)
+      if (!user) throw new NotFoundError('User')
+      return user
+    }
+  )
+
+  app.put(
+    '/:id',
+    {
+      schema: {
+        params: Type.Object({ id: Type.String({ format: 'uuid' }) }),
+        body: Type.Object(
+          {
+            name: Type.Optional(Type.String({ minLength: 1, maxLength: 200 })),
+            email: Type.Optional(Type.String({ format: 'email', maxLength: 320 }))
+          },
+          { additionalProperties: false, minProperties: 1 }
+        ),
+        response: { 200: User }
+      }
+    },
+    async (request) => {
+      const { id } = request.params
+      const { companyId, userId } = request.auth
+      // Only field names are logged; values are PII.
+      const log = request.log.child({ targetUserId: id, fields: Object.keys(request.body) })
+
+      if (userId !== id) {
+        log.warn('user update rejected: caller is not the target user')
+        throw new ForbiddenError()
+      }
+
+      log.info('user update requested')
+      const user = await updateUser(app.db, companyId, id, request.body).catch((err: unknown) => {
+        if ((err as { code?: unknown }).code === UNIQUE_VIOLATION) {
+          log.warn('user update failed: email already in use')
+          throw new AppError('Email already in use', 409, 'CONFLICT')
+        }
+        throw err
+      })
+      if (!user) {
+        log.warn('user update failed: user not found')
+        throw new NotFoundError('User')
+      }
+      log.info('user updated')
+      return user
+    }
+  )
+}
