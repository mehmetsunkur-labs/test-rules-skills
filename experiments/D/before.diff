+import { describe, expect, it } from 'vitest'
+import { buildApp } from '../app.js'
+import type { Db } from '../db.js'
+
+const COMPANY_A = '11111111-1111-4111-8111-111111111111'
+const COMPANY_B = '22222222-2222-4222-8222-222222222222'
+const USER = '33333333-3333-4333-8333-333333333333'
+const OTHER_USER = '55555555-5555-4555-8555-555555555555'
+
+type Row = Record<string, unknown>
+
+function fakeDb(rows: Row[], opts: { failWith?: Error } = {}): Db {
+  return {
+    query: (async (sql: string, params: unknown[]) => {
+      if (opts.failWith) throw opts.failWith
+      const matches = rows.filter((r) => r.company_id === params[0] && r.id === params[1])
+      if (sql.startsWith('UPDATE')) {
+        for (const r of matches) {
+          if (params[2] != null) r.name = params[2]
+          if (params[3] != null) r.email = params[3]
+        }
+      }
+      return { rows: matches }
+    }) as unknown as Db['query']
+  }
+}
+
+function userRow(): Row {
+  return {
+    id: USER,
+    company_id: COMPANY_A,
+    name: 'Ada',
+    email: 'ada@example.com',
+    created_at: new Date('2026-01-01T00:00:00Z')
+  }
+}
+
+const auth = (userId: string, companyId: string) => ({ authorization: `Bearer ${userId}:${companyId}:employee` })
+
+describe('GET /users/:id', () => {
+  it('returns the user for the caller company', async () => {
+    const app = await buildApp({ db: fakeDb([userRow()]), logger: false })
+    const res = await app.inject({ method: 'GET', url: `/users/${USER}`, headers: auth(USER, COMPANY_A) })
+    expect(res.statusCode).toBe(200)
+    expect(res.json()).toEqual({ id: USER, name: 'Ada', email: 'ada@example.com', createdAt: '2026-01-01T00:00:00.000Z' })
+  })
+
+  it('returns 404 for a user that does not exist', async () => {
+    const app = await buildApp({ db: fakeDb([]), logger: false })
+    const res = await app.inject({ method: 'GET', url: `/users/${USER}`, headers: auth(USER, COMPANY_A) })
+    expect(res.statusCode).toBe(404)
+    expect(res.json()).toMatchObject({ code: 'NOT_FOUND' })
+  })
+
+  it('returns 404 for a user that belongs to another company', async () => {
+    const app = await buildApp({ db: fakeDb([userRow()]), logger: false })
+    const res = await app.inject({ method: 'GET', url: `/users/${USER}`, headers: auth(USER, COMPANY_B) })
+    expect(res.statusCode).toBe(404)
+  })
+
+  it('returns 400 for a non-uuid id', async () => {
+    const app = await buildApp({ db: fakeDb([userRow()]), logger: false })
+    const res = await app.inject({ method: 'GET', url: `/users/${encodeURIComponent("1' OR '1'='1")}`, headers: auth(USER, COMPANY_A) })
+    expect(res.statusCode).toBe(400)
+  })
+
+  it('returns 500 instead of an empty object when the database fails', async () => {
+    const app = await buildApp({ db: fakeDb([], { failWith: new Error('connection lost') }), logger: false })
+    const res = await app.inject({ method: 'GET', url: `/users/${USER}`, headers: auth(USER, COMPANY_A) })
+    expect(res.statusCode).toBe(500)
+    expect(res.json()).toMatchObject({ code: 'INTERNAL_ERROR' })
+  })
+})
+
+describe('PUT /users/:id', () => {
+  it('updates the caller name and email', async () => {
+    const app = await buildApp({ db: fakeDb([userRow()]), logger: false })
+    const res = await app.inject({
+      method: 'PUT',
+      url: `/users/${USER}`,
+      headers: auth(USER, COMPANY_A),
+      payload: { name: 'Ada Lovelace', email: 'ada.l@example.com' }
+    })
+    expect(res.statusCode).toBe(200)
+    expect(res.json()).toMatchObject({ name: 'Ada Lovelace', email: 'ada.l@example.com' })
+  })
+
+  it('allows updating a single field', async () => {
+    const app = await buildApp({ db: fakeDb([userRow()]), logger: false })
+    const res = await app.inject({
+      method: 'PUT',
+      url: `/users/${USER}`,
+      headers: auth(USER, COMPANY_A),
+      payload: { name: 'Ada Lovelace' }
+    })
+    expect(res.statusCode).toBe(200)
+    expect(res.json()).toMatchObject({ name: 'Ada Lovelace', email: 'ada@example.com' })
+  })
+
+  it('returns 403 when updating another user', async () => {
+    const app = await buildApp({ db: fakeDb([userRow()]), logger: false })
+    const res = await app.inject({
+      method: 'PUT',
+      url: `/users/${USER}`,
+      headers: auth(OTHER_USER, COMPANY_A),
+      payload: { name: 'Mallory' }
+    })
+    expect(res.statusCode).toBe(403)
+  })
+
+  it.each([
+    ['empty body', {}],
+    ['invalid email', { email: 'not-an-email' }],
+    ['empty name', { name: '' }]
+  ])('returns 400 for %s', async (_label, payload) => {
+    const app = await buildApp({ db: fakeDb([userRow()]), logger: false })
+    const res = await app.inject({ method: 'PUT', url: `/users/${USER}`, headers: auth(USER, COMPANY_A), payload })
+    expect(res.statusCode).toBe(400)
+  })
+
+  it('returns 409 when the email is already taken', async () => {
+    const err = Object.assign(new Error('duplicate key'), { code: '23505' })
+    const app = await buildApp({ db: fakeDb([], { failWith: err }), logger: false })
+    const res = await app.inject({
+      method: 'PUT',
+      url: `/users/${USER}`,
+      headers: auth(USER, COMPANY_A),
+      payload: { email: 'taken@example.com' }
+    })
+    expect(res.statusCode).toBe(409)
+    expect(res.json()).toMatchObject({ code: 'CONFLICT' })
+  })
+})
