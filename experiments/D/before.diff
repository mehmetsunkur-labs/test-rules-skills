@@ -0,0 +1,57 @@
+import type { Db } from '../db.js'
+
+export interface User {
+  id: string
+  companyId: string
+  name: string
+  email: string
+  createdAt: string
+}
+
+export interface UserUpdate {
+  name?: string
+  email?: string
+}
+
+interface UserRow {
+  id: string
+  company_id: string
+  name: string
+  email: string
+  created_at: Date
+}
+
+const COLUMNS = 'id, company_id, name, email, created_at'
+
+function toUser(row: UserRow): User {
+  return {
+    id: row.id,
+    companyId: row.company_id,
+    name: row.name,
+    email: row.email,
+    createdAt: row.created_at.toISOString()
+  }
+}
+
+export async function findUserById(db: Db, companyId: string, id: string): Promise<User | undefined> {
+  const { rows } = await db.query<UserRow>(`SELECT ${COLUMNS} FROM users WHERE company_id = $1 AND id = $2`, [
+    companyId,
+    id
+  ])
+  return rows[0] && toUser(rows[0])
+}
+
+export async function updateUser(
+  db: Db,
+  companyId: string,
+  id: string,
+  update: UserUpdate
+): Promise<User | undefined> {
+  const { rows } = await db.query<UserRow>(
+    `UPDATE users SET name = COALESCE($3, name), email = COALESCE($4, email)
+     WHERE company_id = $1 AND id = $2
+     RETURNING ${COLUMNS}`,
+    [companyId, id, update.name ?? null, update.email ?? null]
+  )
+  return rows[0] && toUser(rows[0])
+}
