+++ b/src/server/repositories/user-repository.ts
@@ -0,0 +1,52 @@
+import type { Db } from '../db.js'
+
+export interface User {
+  id: string
+  companyId: string
+  name: string
+  email: string
+}
+
+export interface UserUpdate {
+  name: string
+  email: string
+}
+
+interface UserRow {
+  id: string
+  company_id: string
+  name: string
+  email: string
+}
+
+const COLUMNS = 'id, company_id, name, email'
+
+function toUser(row: UserRow): User {
+  return {
+    id: row.id,
+    companyId: row.company_id,
+    name: row.name,
+    email: row.email
+  }
+}
+
+export async function findUserById(db: Db, companyId: string, id: string): Promise<User | undefined> {
+  const { rows } = await db.query<UserRow>(`SELECT ${COLUMNS} FROM users WHERE company_id = $1 AND id = $2`, [
+    companyId,
+    id
+  ])
+  return rows[0] && toUser(rows[0])
+}
+
+export async function updateUser(
+  db: Db,
+  companyId: string,
+  id: string,
+  update: UserUpdate
+): Promise<User | undefined> {
+  const { rows } = await db.query<UserRow>(
+    `UPDATE users SET name = $3, email = $4 WHERE company_id = $1 AND id = $2 RETURNING ${COLUMNS}`,
+    [companyId, id, update.name, update.email]
+  )
+  return rows[0] && toUser(rows[0])
+}
