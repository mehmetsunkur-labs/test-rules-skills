+import { Type } from '@sinclair/typebox'
+import type { FastifyPluginAsyncTypebox } from '@fastify/type-provider-typebox'
+import { ForbiddenError, NotFoundError } from '../errors.js'
+import type { AuthContext } from '../plugins/auth.js'
+import { findUserById, updateUser } from '../repositories/user-repository.js'
+
+const User = Type.Object({
+  id: Type.String({ format: 'uuid' }),
+  name: Type.String(),
+  email: Type.String()
+})
+
+const UserParams = Type.Object({ id: Type.String({ format: 'uuid' }) })
+
+const UserUpdateBody = Type.Object(
+  {
+    name: Type.String({ minLength: 1, maxLength: 200 }),
+    email: Type.String({ format: 'email', maxLength: 254 })
+  },
+  { additionalProperties: false }
+)
+
+export function canUpdateUser(auth: AuthContext, userId: string): boolean {
+  return auth.userId === userId
+}
+
+export const userRoutes: FastifyPluginAsyncTypebox = async (app) => {
+  app.get(
+    '/:id',
+    {
+      schema: {
+        params: UserParams,
+        response: { 200: User }
+      }
+    },
+    async (request) => {
+      const user = await findUserById(app.db, request.auth.companyId, request.params.id)
+      if (!user) throw new NotFoundError('User')
+      return user
+    }
+  )
+
+  app.put(
+    '/:id',
+    {
+      schema: {
+        params: UserParams,
+        body: UserUpdateBody,
+        response: { 200: User }
+      }
+    },
+    async (request) => {
+      const { companyId, userId: actorId } = request.auth
+      const userId = request.params.id
+
+      if (!canUpdateUser(request.auth, userId)) {
+        // Colleagues in the same company can read the user, so they get 403; anyone else gets 404.
+        const target = await findUserById(app.db, companyId, userId)
+        if (!target) throw new NotFoundError('User')
+        request.log.warn({ userId, actorId }, 'user update forbidden')
+        throw new ForbiddenError()
+      }
+
+      const user = await updateUser(app.db, companyId, userId, request.body)
+      if (!user) throw new NotFoundError('User')
+      request.log.info({ userId, actorId }, 'user updated')
+      return user
+    }
+  )
+}
