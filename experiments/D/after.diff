+++ b/src/server/routes/users.test.ts
@@ -0,0 +1,147 @@
+import { describe, expect, it } from 'vitest'
+import { buildApp } from '../app.js'
+import type { Db } from '../db.js'
+
+const COMPANY_A = '11111111-1111-4111-8111-111111111111'
+const COMPANY_B = '22222222-2222-4222-8222-222222222222'
+const USER_ID = '33333333-3333-4333-8333-333333333333'
+const COLLEAGUE_ID = '55555555-5555-4555-8555-555555555555'
+const MISSING_ID = '66666666-6666-4666-8666-666666666666'
+
+interface FakeUserRow {
+  id: string
+  company_id: string
+  name: string
+  email: string
+}
+
+function userRow(): FakeUserRow {
+  return { id: USER_ID, company_id: COMPANY_A, name: 'Ada Lovelace', email: 'ada@example.com' }
+}
+
+function fakeDb(rows: FakeUserRow[]): Db {
+  return {
+    query: (async (sql: string, params: unknown[]) => {
+      const matches = rows.filter((r) => r.company_id === params[0] && r.id === params[1])
+      if (sql.startsWith('UPDATE')) {
+        for (const r of matches) {
+          r.name = String(params[2])
+          r.email = String(params[3])
+        }
+      }
+      return { rows: matches }
+    }) as unknown as Db['query']
+  }
+}
+
+function failingDb(): Db {
+  return {
+    query: (async () => {
+      throw new Error('connection terminated')
+    }) as unknown as Db['query']
+  }
+}
+
+function authHeader(userId: string, companyId: string): { authorization: string } {
+  return { authorization: `Bearer ${userId}:${companyId}:employee` }
+}
+
+describe('GET /users/:id', () => {
+  it('returns the user for the caller company without internal columns', async () => {
+    const app = await buildApp({ db: fakeDb([userRow()]), logger: false })
+    const res = await app.inject({ method: 'GET', url: `/users/${USER_ID}`, headers: authHeader(USER_ID, COMPANY_A) })
+    expect(res.statusCode).toBe(200)
+    expect(res.json()).toEqual({ id: USER_ID, name: 'Ada Lovelace', email: 'ada@example.com' })
+  })
+
+  it('returns 404 instead of an empty body when the user does not exist', async () => {
+    const app = await buildApp({ db: fakeDb([userRow()]), logger: false })
+    const res = await app.inject({ method: 'GET', url: `/users/${MISSING_ID}`, headers: authHeader(USER_ID, COMPANY_A) })
+    expect(res.statusCode).toBe(404)
+    expect(res.json()).toMatchObject({ code: 'NOT_FOUND' })
+  })
+
+  it('returns 400 instead of an empty body for a non-uuid id', async () => {
+    const app = await buildApp({ db: fakeDb([userRow()]), logger: false })
+    const res = await app.inject({ method: 'GET', url: '/users/not-a-uuid', headers: authHeader(USER_ID, COMPANY_A) })
+    expect(res.statusCode).toBe(400)
+    expect(res.json()).toMatchObject({ code: 'VALIDATION_ERROR' })
+  })
+
+  it('returns 500 instead of an empty body when the database fails', async () => {
+    const app = await buildApp({ db: failingDb(), logger: false })
+    const res = await app.inject({ method: 'GET', url: `/users/${USER_ID}`, headers: authHeader(USER_ID, COMPANY_A) })
+    expect(res.statusCode).toBe(500)
+    expect(res.json()).toEqual({ code: 'INTERNAL_ERROR', message: 'Internal server error' })
+  })
+
+  it('returns 404 for a user that belongs to another company', async () => {
+    const app = await buildApp({ db: fakeDb([userRow()]), logger: false })
+    const res = await app.inject({ method: 'GET', url: `/users/${USER_ID}`, headers: authHeader(USER_ID, COMPANY_B) })
+    expect(res.statusCode).toBe(404)
+  })
+})
+
+describe('PUT /users/:id', () => {
+  const update = { name: 'Ada King', email: 'ada.king@example.com' }
+
+  it('updates the caller own name and email', async () => {
+    const app = await buildApp({ db: fakeDb([userRow()]), logger: false })
+    const res = await app.inject({
+      method: 'PUT',
+      url: `/users/${USER_ID}`,
+      headers: authHeader(USER_ID, COMPANY_A),
+      payload: update
+    })
+    expect(res.statusCode).toBe(200)
+    expect(res.json()).toEqual({ id: USER_ID, ...update })
+  })
+
+  it('returns 400 for an invalid email', async () => {
+    const app = await buildApp({ db: fakeDb([userRow()]), logger: false })
+    const res = await app.inject({
+      method: 'PUT',
+      url: `/users/${USER_ID}`,
+      headers: authHeader(USER_ID, COMPANY_A),
+      payload: { name: 'Ada King', email: 'not-an-email' }
+    })
+    expect(res.statusCode).toBe(400)
+  })
+
+  it('returns 400 when a field is missing', async () => {
+    const app = await buildApp({ db: fakeDb([userRow()]), logger: false })
+    const res = await app.inject({
+      method: 'PUT',
+      url: `/users/${USER_ID}`,
+      headers: authHeader(USER_ID, COMPANY_A),
+      payload: { name: 'Ada King' }
+    })
+    expect(res.statusCode).toBe(400)
+  })
+
+  it('returns 404 for a user that belongs to another company', async () => {
+    const row = userRow()
+    const app = await buildApp({ db: fakeDb([row]), logger: false })
+    const res = await app.inject({
+      method: 'PUT',
+      url: `/users/${USER_ID}`,
+      headers: authHeader(COLLEAGUE_ID, COMPANY_B),
+      payload: update
+    })
+    expect(res.statusCode).toBe(404)
+    expect(row.name).toBe('Ada Lovelace')
+  })
+
+  it('returns 403 when a colleague tries to update another user', async () => {
+    const row = userRow()
+    const app = await buildApp({ db: fakeDb([row]), logger: false })
+    const res = await app.inject({
+      method: 'PUT',
+      url: `/users/${USER_ID}`,
+      headers: authHeader(COLLEAGUE_ID, COMPANY_A),
+      payload: update
+    })
+    expect(res.statusCode).toBe(403)
+    expect(row.name).toBe('Ada Lovelace')
+  })
+})
