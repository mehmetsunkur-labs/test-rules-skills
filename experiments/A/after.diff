+import { describe, expect, it } from 'vitest'
+import { buildApp } from '../app.js'
+import type { Db } from '../db.js'
+
+const COMPANY_A = '11111111-1111-4111-8111-111111111111'
+const COMPANY_B = '22222222-2222-4222-8222-222222222222'
+const AUTHOR = '33333333-3333-4333-8333-333333333333'
+const RECIPIENT = '55555555-5555-4555-8555-555555555555'
+const OTHER_USER = '66666666-6666-4666-8666-666666666666'
+const FEEDBACK_ID = '44444444-4444-4444-8444-444444444444'
+const NEW_ID = '77777777-7777-4777-8777-777777777777'
+
+interface UserRow {
+  id: string
+  company_id: string
+}
+
+function fakeDb(feedbackRows: Record<string, unknown>[], users: UserRow[] = []): Db {
+  return {
+    query: (async (sql: string, params: unknown[]) => {
+      if (sql.trimStart().startsWith('INSERT')) {
+        const [companyId, authorId, recipientId, body, visibility] = params
+        const recipientInCompany = users.some((u) => u.company_id === companyId && u.id === recipientId)
+        if (!recipientInCompany) return { rows: [] }
+        return {
+          rows: [
+            {
+              id: NEW_ID,
+              company_id: companyId,
+              author_id: authorId,
+              recipient_id: recipientId,
+              body,
+              visibility,
+              created_at: new Date('2026-02-01T00:00:00Z')
+            }
+          ]
+        }
+      }
+      return { rows: feedbackRows.filter((r) => r.company_id === params[0] && r.id === params[1]) }
+    }) as unknown as Db['query']
+  }
+}
+
+function feedbackRow(visibility: 'private' | 'shared'): Record<string, unknown> {
+  return {
+    id: FEEDBACK_ID,
+    company_id: COMPANY_A,
+    author_id: AUTHOR,
+    recipient_id: RECIPIENT,
+    body: 'Great presentation',
+    visibility,
+    created_at: new Date('2026-01-01T00:00:00Z')
+  }
+}
+
+function bearer(userId: string, companyId: string, role: 'employee' | 'manager' | 'admin' = 'employee'): string {
+  return `Bearer ${userId}:${companyId}:${role}`
+}
+
+describe('GET /feedback/:id', () => {
+  it('returns private feedback to its recipient without internal columns', async () => {
+    const app = await buildApp({ db: fakeDb([feedbackRow('private')]), logger: false })
+    const res = await app.inject({
+      method: 'GET',
+      url: `/feedback/${FEEDBACK_ID}`,
+      headers: { authorization: bearer(RECIPIENT, COMPANY_A) }
+    })
+    expect(res.statusCode).toBe(200)
+    const json = res.json()
+    expect(json).toMatchObject({ id: FEEDBACK_ID, authorId: AUTHOR, recipientId: RECIPIENT, visibility: 'private' })
+    expect(json).not.toHaveProperty('companyId')
+  })
+
+  it('returns shared feedback to any user in the same company', async () => {
+    const app = await buildApp({ db: fakeDb([feedbackRow('shared')]), logger: false })
+    const res = await app.inject({
+      method: 'GET',
+      url: `/feedback/${FEEDBACK_ID}`,
+      headers: { authorization: bearer(OTHER_USER, COMPANY_A) }
+    })
+    expect(res.statusCode).toBe(200)
+  })
+
+  it('returns private feedback to an admin of the same company', async () => {
+    const app = await buildApp({ db: fakeDb([feedbackRow('private')]), logger: false })
+    const res = await app.inject({
+      method: 'GET',
+      url: `/feedback/${FEEDBACK_ID}`,
+      headers: { authorization: bearer(OTHER_USER, COMPANY_A, 'admin') }
+    })
+    expect(res.statusCode).toBe(200)
+  })
+
+  it('returns 403 for private feedback when the caller is neither author, recipient nor admin', async () => {
+    const app = await buildApp({ db: fakeDb([feedbackRow('private')]), logger: false })
+    const res = await app.inject({
+      method: 'GET',
+      url: `/feedback/${FEEDBACK_ID}`,
+      headers: { authorization: bearer(OTHER_USER, COMPANY_A, 'manager') }
+    })
+    expect(res.statusCode).toBe(403)
+  })
+
+  it('returns 404 for feedback from another company', async () => {
+    const app = await buildApp({ db: fakeDb([feedbackRow('shared')]), logger: false })
+    const res = await app.inject({
+      method: 'GET',
+      url: `/feedback/${FEEDBACK_ID}`,
+      headers: { authorization: bearer(AUTHOR, COMPANY_B, 'admin') }
+    })
+    expect(res.statusCode).toBe(404)
+  })
+
+  it('returns 400 for a non-uuid id', async () => {
+    const app = await buildApp({ db: fakeDb([]), logger: false })
+    const res = await app.inject({
+      method: 'GET',
+      url: '/feedback/not-a-uuid',
+      headers: { authorization: bearer(AUTHOR, COMPANY_A) }
+    })
+    expect(res.statusCode).toBe(400)
+  })
+})
+
+describe('POST /feedback', () => {
+  const users: UserRow[] = [{ id: RECIPIENT, company_id: COMPANY_A }]
+
+  it('creates private feedback authored by the caller by default', async () => {
+    const app = await buildApp({ db: fakeDb([], users), logger: false })
+    const res = await app.inject({
+      method: 'POST',
+      url: '/feedback',
+      headers: { authorization: bearer(AUTHOR, COMPANY_A) },
+      payload: { recipientId: RECIPIENT, body: 'Thanks for the help' }
+    })
+    expect(res.statusCode).toBe(201)
+    const json = res.json()
+    expect(json).toMatchObject({ id: NEW_ID, authorId: AUTHOR, recipientId: RECIPIENT, visibility: 'private' })
+    expect(json).not.toHaveProperty('companyId')
+  })
+
+  it('returns 400 for an empty body', async () => {
+    const app = await buildApp({ db: fakeDb([], users), logger: false })
+    const res = await app.inject({
+      method: 'POST',
+      url: '/feedback',
+      headers: { authorization: bearer(AUTHOR, COMPANY_A) },
+      payload: { recipientId: RECIPIENT, body: '' }
+    })
+    expect(res.statusCode).toBe(400)
+  })
+
+  it('returns 400 for an unknown visibility', async () => {
+    const app = await buildApp({ db: fakeDb([], users), logger: false })
+    const res = await app.inject({
+      method: 'POST',
+      url: '/feedback',
+      headers: { authorization: bearer(AUTHOR, COMPANY_A) },
+      payload: { recipientId: RECIPIENT, body: 'Hi', visibility: 'public' }
+    })
+    expect(res.statusCode).toBe(400)
+  })
+
+  it('ignores authorId and companyId in the body and uses the caller identity', async () => {
+    const app = await buildApp({ db: fakeDb([], users), logger: false })
+    const res = await app.inject({
+      method: 'POST',
+      url: '/feedback',
+      headers: { authorization: bearer(AUTHOR, COMPANY_A) },
+      payload: { recipientId: RECIPIENT, body: 'Hi', authorId: OTHER_USER, companyId: COMPANY_B }
+    })
+    expect(res.statusCode).toBe(201)
+    expect(res.json()).toMatchObject({ authorId: AUTHOR })
+  })
+
+  it('returns 404 when the recipient belongs to another company', async () => {
+    const app = await buildApp({ db: fakeDb([], users), logger: false })
+    const res = await app.inject({
+      method: 'POST',
+      url: '/feedback',
+      headers: { authorization: bearer(AUTHOR, COMPANY_B) },
+      payload: { recipientId: RECIPIENT, body: 'Hi' }
+    })
+    expect(res.statusCode).toBe(404)
+  })
+})
