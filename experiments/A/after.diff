@@ -0,0 +1,67 @@
+import type { Db } from '../db.js'
+
+export type FeedbackVisibility = 'private' | 'shared'
+
+export interface Feedback {
+  id: string
+  companyId: string
+  authorId: string
+  recipientId: string
+  body: string
+  visibility: FeedbackVisibility
+  createdAt: string
+}
+
+export interface NewFeedback {
+  authorId: string
+  recipientId: string
+  body: string
+  visibility: FeedbackVisibility
+}
+
+interface FeedbackRow {
+  id: string
+  company_id: string
+  author_id: string
+  recipient_id: string
+  body: string
+  visibility: FeedbackVisibility
+  created_at: Date
+}
+
+const COLUMNS = 'id, company_id, author_id, recipient_id, body, visibility, created_at'
+
+function toFeedback(row: FeedbackRow): Feedback {
+  return {
+    id: row.id,
+    companyId: row.company_id,
+    authorId: row.author_id,
+    recipientId: row.recipient_id,
+    body: row.body,
+    visibility: row.visibility,
+    createdAt: row.created_at.toISOString()
+  }
+}
+
+export async function findFeedbackById(db: Db, companyId: string, id: string): Promise<Feedback | undefined> {
+  const { rows } = await db.query<FeedbackRow>(`SELECT ${COLUMNS} FROM feedback WHERE company_id = $1 AND id = $2`, [
+    companyId,
+    id
+  ])
+  return rows[0] && toFeedback(rows[0])
+}
+
+/**
+ * Inserts feedback only if the recipient belongs to the same company.
+ * Returns undefined when the recipient is not found in `companyId`.
+ */
+export async function createFeedback(db: Db, companyId: string, input: NewFeedback): Promise<Feedback | undefined> {
+  const { rows } = await db.query<FeedbackRow>(
+    `INSERT INTO feedback (company_id, author_id, recipient_id, body, visibility)
+     SELECT $1, $2, $3, $4, $5
+     WHERE EXISTS (SELECT 1 FROM users WHERE company_id = $1 AND id = $3)
+     RETURNING ${COLUMNS}`,
+    [companyId, input.authorId, input.recipientId, input.body, input.visibility]
+  )
+  return rows[0] && toFeedback(rows[0])
+}
