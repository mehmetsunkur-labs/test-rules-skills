+import { Type } from '@sinclair/typebox'
+import type { FastifyPluginAsyncTypebox } from '@fastify/type-provider-typebox'
+import { ForbiddenError, NotFoundError } from '../errors.js'
+import type { AuthContext } from '../plugins/auth.js'
+import { createFeedback, findFeedbackById, type Feedback } from '../repositories/feedback-repository.js'
+
+const Visibility = Type.Union([Type.Literal('private'), Type.Literal('shared')])
+
+const FeedbackResponse = Type.Object({
+  id: Type.String({ format: 'uuid' }),
+  authorId: Type.String({ format: 'uuid' }),
+  recipientId: Type.String({ format: 'uuid' }),
+  body: Type.String({ maxLength: 5000 }),
+  visibility: Visibility,
+  createdAt: Type.String({ format: 'date-time' })
+})
+
+const CreateFeedbackBody = Type.Object(
+  {
+    recipientId: Type.String({ format: 'uuid' }),
+    body: Type.String({ minLength: 1, maxLength: 5000 }),
+    visibility: Type.Optional(Visibility)
+  },
+  { additionalProperties: false }
+)
+
+/** Shared feedback is visible company-wide; private feedback only to its author, recipient and admins. */
+export function canViewFeedback(auth: AuthContext, feedback: Feedback): boolean {
+  if (feedback.visibility === 'shared') return true
+  if (auth.role === 'admin') return true
+  return auth.userId === feedback.authorId || auth.userId === feedback.recipientId
+}
+
+export const feedbackRoutes: FastifyPluginAsyncTypebox = async (app) => {
+  app.get(
+    '/:id',
+    {
+      schema: {
+        params: Type.Object({ id: Type.String({ format: 'uuid' }) }),
+        response: { 200: FeedbackResponse }
+      }
+    },
+    async (request) => {
+      const feedback = await findFeedbackById(app.db, request.auth.companyId, request.params.id)
+      if (!feedback) throw new NotFoundError('Feedback')
+      if (!canViewFeedback(request.auth, feedback)) throw new ForbiddenError()
+      return feedback
+    }
+  )
+
+  app.post(
+    '/',
+    {
+      schema: {
+        body: CreateFeedbackBody,
+        response: { 201: FeedbackResponse }
+      }
+    },
+    async (request, reply) => {
+      const feedback = await createFeedback(app.db, request.auth.companyId, {
+        authorId: request.auth.userId,
+        recipientId: request.body.recipientId,
+        body: request.body.body,
+        visibility: request.body.visibility ?? 'private'
+      })
+      if (!feedback) throw new NotFoundError('Recipient')
+      request.log.info({ feedbackId: feedback.id }, 'feedback created')
+      return reply.status(201).send(feedback)
+    }
+  )
+}
