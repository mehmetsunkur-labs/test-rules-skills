index 0000000..d55158a
--- /dev/null
+++ b/src/server/repositories/feedback-repository.ts
@@ -0,0 +1,71 @@
+import type { Db } from '../db.js'
+
+export type FeedbackVisibility = 'private' | 'shared'
+
+export interface Feedback {
+  id: string
+  companyId: string
+  authorId: string
+  recipientId: string
+  body: string
+  visibility: FeedbackVisibility
+  createdAt: string
+}
+
+export interface NewFeedback {
+  companyId: string
+  authorId: string
+  recipientId: string
+  body: string
+  visibility: FeedbackVisibility
+}
+
+interface FeedbackRow {
+  id: string
+  company_id: string
+  author_id: string
+  recipient_id: string
+  body: string
+  visibility: FeedbackVisibility
+  created_at: Date
+}
+
+const COLUMNS = 'id, company_id, author_id, recipient_id, body, visibility, created_at'
+
+function toFeedback(row: FeedbackRow): Feedback {
+  return {
+    id: row.id,
+    companyId: row.company_id,
+    authorId: row.author_id,
+    recipientId: row.recipient_id,
+    body: row.body,
+    visibility: row.visibility,
+    createdAt: row.created_at.toISOString()
+  }
+}
+
+// Only the author and the recipient may read a feedback item.
+export async function findFeedbackForUser(
+  db: Db,
+  companyId: string,
+  userId: string,
+  id: string
+): Promise<Feedback | undefined> {
+  const { rows } = await db.query<FeedbackRow>(
+    `SELECT ${COLUMNS} FROM feedback
+     WHERE company_id = $1 AND id = $2 AND (author_id = $3 OR recipient_id = $3)`,
+    [companyId, id, userId]
+  )
+  return rows[0] && toFeedback(rows[0])
+}
+
+// Inserts only if the recipient belongs to the same company; returns undefined otherwise.
+export async function createFeedback(db: Db, input: NewFeedback): Promise<Feedback | undefined> {
+  const { rows } = await db.query<FeedbackRow>(
+    `INSERT INTO feedback (company_id, author_id, recipient_id, body, visibility)
+     SELECT $1, $2, u.id, $4, $5 FROM users u WHERE u.company_id = $1 AND u.id = $3
+     RETURNING ${COLUMNS}`,
+    [input.companyId, input.authorId, input.recipientId, input.body, input.visibility]
+  )
+  return rows[0] && toFeedback(rows[0])
+}
