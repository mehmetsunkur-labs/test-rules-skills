+import { Type } from '@sinclair/typebox'
+import type { FastifyPluginAsyncTypebox } from '@fastify/type-provider-typebox'
+import { AppError, NotFoundError } from '../errors.js'
+import { createFeedback, findFeedbackForUser } from '../repositories/feedback-repository.js'
+
+const Visibility = Type.Union([Type.Literal('private'), Type.Literal('shared')])
+
+const Feedback = Type.Object({
+  id: Type.String({ format: 'uuid' }),
+  authorId: Type.String({ format: 'uuid' }),
+  recipientId: Type.String({ format: 'uuid' }),
+  body: Type.String(),
+  visibility: Visibility,
+  createdAt: Type.String({ format: 'date-time' })
+})
+
+const CreateFeedbackBody = Type.Object(
+  {
+    recipientId: Type.String({ format: 'uuid' }),
+    body: Type.String({ minLength: 1, maxLength: 10000, pattern: '\\S' }),
+    visibility: Type.Optional(Visibility)
+  },
+  { additionalProperties: false }
+)
+
+export const feedbackRoutes: FastifyPluginAsyncTypebox = async (app) => {
+  app.get(
+    '/:id',
+    {
+      schema: {
+        params: Type.Object({ id: Type.String({ format: 'uuid' }) }),
+        response: { 200: Feedback }
+      }
+    },
+    async (request) => {
+      const { companyId, userId } = request.auth
+      const feedback = await findFeedbackForUser(app.db, companyId, userId, request.params.id)
+      if (!feedback) throw new NotFoundError('Feedback')
+      return feedback
+    }
+  )
+
+  app.post(
+    '/',
+    {
+      schema: {
+        body: CreateFeedbackBody,
+        response: { 201: Feedback }
+      }
+    },
+    async (request, reply) => {
+      const { companyId, userId } = request.auth
+      const { recipientId, body, visibility = 'private' } = request.body
+      if (recipientId === userId) {
+        throw new AppError('Cannot give feedback to yourself', 400, 'VALIDATION_ERROR')
+      }
+      const feedback = await createFeedback(app.db, { companyId, authorId: userId, recipientId, body, visibility })
+      if (!feedback) throw new NotFoundError('Recipient')
+      return reply.status(201).send(feedback)
+    }
+  )
+}
