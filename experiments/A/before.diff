@@ -0,0 +1,142 @@
+import { describe, expect, it } from 'vitest'
+import { buildApp } from '../app.js'
+import type { Db } from '../db.js'
+
+const COMPANY_A = '11111111-1111-4111-8111-111111111111'
+const COMPANY_B = '22222222-2222-4222-8222-222222222222'
+const AUTHOR = '33333333-3333-4333-8333-333333333333'
+const RECIPIENT = '55555555-5555-4555-8555-555555555555'
+const OUTSIDER = '66666666-6666-4666-8666-666666666666'
+const FEEDBACK_ID = '44444444-4444-4444-8444-444444444444'
+
+interface Row extends Record<string, unknown> {
+  id: string
+  company_id: string
+}
+
+function fakeDb(feedback: Row[], users: Row[]): Db {
+  return {
+    query: (async (sql: string, params: unknown[]) => {
+      if (sql.startsWith('INSERT')) {
+        const [companyId, authorId, recipientId, body, visibility] = params
+        if (!users.some((u) => u.company_id === companyId && u.id === recipientId)) return { rows: [] }
+        const row = {
+          id: FEEDBACK_ID,
+          company_id: companyId,
+          author_id: authorId,
+          recipient_id: recipientId,
+          body,
+          visibility,
+          created_at: new Date('2026-01-01T00:00:00Z')
+        }
+        return { rows: [row] }
+      }
+      const [companyId, id, userId] = params
+      return {
+        rows: feedback.filter(
+          (r) => r.company_id === companyId && r.id === id && (r.author_id === userId || r.recipient_id === userId)
+        )
+      }
+    }) as unknown as Db['query']
+  }
+}
+
+const feedbackRow: Row = {
+  id: FEEDBACK_ID,
+  company_id: COMPANY_A,
+  author_id: AUTHOR,
+  recipient_id: RECIPIENT,
+  body: 'Great demo',
+  visibility: 'private',
+  created_at: new Date('2026-01-01T00:00:00Z')
+}
+
+const users: Row[] = [
+  { id: AUTHOR, company_id: COMPANY_A },
+  { id: RECIPIENT, company_id: COMPANY_A },
+  { id: OUTSIDER, company_id: COMPANY_B }
+]
+
+const auth = (userId: string, companyId: string) => ({ authorization: `Bearer ${userId}:${companyId}:employee` })
+
+describe('GET /feedback/:id', () => {
+  it.each([
+    ['author', AUTHOR],
+    ['recipient', RECIPIENT]
+  ])('returns the feedback to its %s', async (_label, userId) => {
+    const app = await buildApp({ db: fakeDb([feedbackRow], users), logger: false })
+    const res = await app.inject({ method: 'GET', url: `/feedback/${FEEDBACK_ID}`, headers: auth(userId, COMPANY_A) })
+    expect(res.statusCode).toBe(200)
+    expect(res.json()).toMatchObject({ id: FEEDBACK_ID, body: 'Great demo', visibility: 'private' })
+    expect(res.json()).not.toHaveProperty('companyId')
+  })
+
+  it('returns 404 to a same-company user who is neither author nor recipient', async () => {
+    const app = await buildApp({ db: fakeDb([feedbackRow], users), logger: false })
+    const res = await app.inject({ method: 'GET', url: `/feedback/${FEEDBACK_ID}`, headers: auth(OUTSIDER, COMPANY_A) })
+    expect(res.statusCode).toBe(404)
+  })
+
+  it('returns 404 for feedback that belongs to another company', async () => {
+    const app = await buildApp({ db: fakeDb([feedbackRow], users), logger: false })
+    const res = await app.inject({ method: 'GET', url: `/feedback/${FEEDBACK_ID}`, headers: auth(AUTHOR, COMPANY_B) })
+    expect(res.statusCode).toBe(404)
+  })
+})
+
+describe('POST /feedback', () => {
+  it('creates feedback authored by the caller, defaulting to private', async () => {
+    const app = await buildApp({ db: fakeDb([], users), logger: false })
+    const res = await app.inject({
+      method: 'POST',
+      url: '/feedback',
+      headers: auth(AUTHOR, COMPANY_A),
+      payload: { recipientId: RECIPIENT, body: 'Nice work' }
+    })
+    expect(res.statusCode).toBe(201)
+    expect(res.json()).toMatchObject({ authorId: AUTHOR, recipientId: RECIPIENT, body: 'Nice work', visibility: 'private' })
+  })
+
+  it('ignores a client-supplied authorId', async () => {
+    const app = await buildApp({ db: fakeDb([], users), logger: false })
+    const res = await app.inject({
+      method: 'POST',
+      url: '/feedback',
+      headers: auth(AUTHOR, COMPANY_A),
+      payload: { recipientId: RECIPIENT, body: 'Hi', authorId: OUTSIDER }
+    })
+    expect(res.statusCode).toBe(201)
+    expect(res.json()).toMatchObject({ authorId: AUTHOR })
+  })
+
+  it('returns 404 when the recipient is in another company', async () => {
+    const app = await buildApp({ db: fakeDb([], users), logger: false })
+    const res = await app.inject({
+      method: 'POST',
+      url: '/feedback',
+      headers: auth(AUTHOR, COMPANY_A),
+      payload: { recipientId: OUTSIDER, body: 'Hi' }
+    })
+    expect(res.statusCode).toBe(404)
+  })
+
+  it('rejects feedback to yourself', async () => {
+    const app = await buildApp({ db: fakeDb([], users), logger: false })
+    const res = await app.inject({
+      method: 'POST',
+      url: '/feedback',
+      headers: auth(AUTHOR, COMPANY_A),
+      payload: { recipientId: AUTHOR, body: 'Me' }
+    })
+    expect(res.statusCode).toBe(400)
+  })
+
+  it.each([
+    ['blank body', { recipientId: RECIPIENT, body: '   ' }],
+    ['invalid visibility', { recipientId: RECIPIENT, body: 'Hi', visibility: 'public' }]
+  ])('returns 400 for %s', async (_label, payload) => {
+    const app = await buildApp({ db: fakeDb([], users), logger: false })
+    const res = await app.inject({ method: 'POST', url: '/feedback', headers: auth(AUTHOR, COMPANY_A), payload })
+    expect(res.statusCode).toBe(400)
+  })
+})
