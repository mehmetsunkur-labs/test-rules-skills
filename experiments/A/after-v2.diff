@@ -0,0 +1,175 @@
+import { describe, expect, it } from 'vitest'
+import { buildApp } from '../app.js'
+import type { Db } from '../db.js'
+
+const COMPANY_A = '11111111-1111-4111-8111-111111111111'
+const COMPANY_B = '22222222-2222-4222-8222-222222222222'
+const AUTHOR = '33333333-3333-4333-8333-333333333333'
+const RECIPIENT = '44444444-4444-4444-8444-444444444444'
+const COLLEAGUE = '55555555-5555-4555-8555-555555555555'
+const FEEDBACK_ID = '66666666-6666-4666-8666-666666666666'
+const NEW_ID = '77777777-7777-4777-8777-777777777777'
+
+interface FakeState {
+  feedback: Record<string, unknown>[]
+  users: { id: string; company_id: string }[]
+}
+
+function fakeDb(state: FakeState): Db {
+  return {
+    query: (async (sql: string, params: unknown[]) => {
+      if (sql.startsWith('INSERT INTO feedback')) {
+        const [companyId, authorId, recipientId, body, visibility] = params
+        const recipientInCompany = state.users.some((u) => u.company_id === companyId && u.id === recipientId)
+        if (!recipientInCompany) return { rows: [] }
+        const row = {
+          id: NEW_ID,
+          company_id: companyId,
+          author_id: authorId,
+          recipient_id: recipientId,
+          body,
+          visibility,
+          created_at: new Date('2026-02-01T00:00:00Z')
+        }
+        state.feedback.push(row)
+        return { rows: [row] }
+      }
+      return { rows: state.feedback.filter((r) => r.company_id === params[0] && r.id === params[1]) }
+    }) as unknown as Db['query']
+  }
+}
+
+function feedbackRow(visibility: 'private' | 'shared'): Record<string, unknown> {
+  return {
+    id: FEEDBACK_ID,
+    company_id: COMPANY_A,
+    author_id: AUTHOR,
+    recipient_id: RECIPIENT,
+    body: 'Great presentation',
+    visibility,
+    created_at: new Date('2026-01-01T00:00:00Z')
+  }
+}
+
+const users = [
+  { id: AUTHOR, company_id: COMPANY_A },
+  { id: RECIPIENT, company_id: COMPANY_A },
+  { id: COLLEAGUE, company_id: COMPANY_A }
+]
+
+function auth(userId: string, companyId: string, role = 'employee'): { authorization: string } {
+  return { authorization: `Bearer ${userId}:${companyId}:${role}` }
+}
+
+describe('GET /feedback/:id', () => {
+  it('returns private feedback to its recipient without internal columns', async () => {
+    const app = await buildApp({ db: fakeDb({ feedback: [feedbackRow('private')], users }), logger: false })
+    const res = await app.inject({ method: 'GET', url: `/feedback/${FEEDBACK_ID}`, headers: auth(RECIPIENT, COMPANY_A) })
+    expect(res.statusCode).toBe(200)
+    const body = res.json()
+    expect(body).toMatchObject({ id: FEEDBACK_ID, authorId: AUTHOR, recipientId: RECIPIENT, visibility: 'private' })
+    expect(body).not.toHaveProperty('companyId')
+  })
+
+  it('returns private feedback to its author', async () => {
+    const app = await buildApp({ db: fakeDb({ feedback: [feedbackRow('private')], users }), logger: false })
+    const res = await app.inject({ method: 'GET', url: `/feedback/${FEEDBACK_ID}`, headers: auth(AUTHOR, COMPANY_A) })
+    expect(res.statusCode).toBe(200)
+  })
+
+  it('returns private feedback to a company admin', async () => {
+    const app = await buildApp({ db: fakeDb({ feedback: [feedbackRow('private')], users }), logger: false })
+    const res = await app.inject({
+      method: 'GET',
+      url: `/feedback/${FEEDBACK_ID}`,
+      headers: auth(COLLEAGUE, COMPANY_A, 'admin')
+    })
+    expect(res.statusCode).toBe(200)
+  })
+
+  it('returns 404 when a colleague requests private feedback they are not part of', async () => {
+    const app = await buildApp({ db: fakeDb({ feedback: [feedbackRow('private')], users }), logger: false })
+    const res = await app.inject({
+      method: 'GET',
+      url: `/feedback/${FEEDBACK_ID}`,
+      headers: auth(COLLEAGUE, COMPANY_A, 'manager')
+    })
+    expect(res.statusCode).toBe(404)
+  })
+
+  it('returns shared feedback to a colleague in the same company', async () => {
+    const app = await buildApp({ db: fakeDb({ feedback: [feedbackRow('shared')], users }), logger: false })
+    const res = await app.inject({ method: 'GET', url: `/feedback/${FEEDBACK_ID}`, headers: auth(COLLEAGUE, COMPANY_A) })
+    expect(res.statusCode).toBe(200)
+  })
+
+  it('returns 404 for feedback from another company', async () => {
+    const app = await buildApp({ db: fakeDb({ feedback: [feedbackRow('shared')], users }), logger: false })
+    const res = await app.inject({
+      method: 'GET',
+      url: `/feedback/${FEEDBACK_ID}`,
+      headers: auth(RECIPIENT, COMPANY_B, 'admin')
+    })
+    expect(res.statusCode).toBe(404)
+  })
+
+  it('returns 400 for a non-uuid id', async () => {
+    const app = await buildApp({ db: fakeDb({ feedback: [], users }), logger: false })
+    const res = await app.inject({ method: 'GET', url: '/feedback/not-a-uuid', headers: auth(AUTHOR, COMPANY_A) })
+    expect(res.statusCode).toBe(400)
+  })
+})
+
+describe('POST /feedback', () => {
+  it('creates private feedback authored by the caller by default', async () => {
+    const state: FakeState = { feedback: [], users }
+    const app = await buildApp({ db: fakeDb(state), logger: false })
+    const res = await app.inject({
+      method: 'POST',
+      url: '/feedback',
+      headers: auth(AUTHOR, COMPANY_A),
+      payload: { recipientId: RECIPIENT, body: 'Thanks for the help' }
+    })
+    expect(res.statusCode).toBe(201)
+    expect(res.json()).toMatchObject({ id: NEW_ID, authorId: AUTHOR, recipientId: RECIPIENT, visibility: 'private' })
+    expect(res.json()).not.toHaveProperty('companyId')
+    expect(state.feedback[0]).toMatchObject({ company_id: COMPANY_A, author_id: AUTHOR })
+  })
+
+  it('returns 400 when the body is empty', async () => {
+    const app = await buildApp({ db: fakeDb({ feedback: [], users }), logger: false })
+    const res = await app.inject({
+      method: 'POST',
+      url: '/feedback',
+      headers: auth(AUTHOR, COMPANY_A),
+      payload: { recipientId: RECIPIENT, body: '' }
+    })
+    expect(res.statusCode).toBe(400)
+  })
+
+  it('ignores companyId and authorId sent by the client', async () => {
+    const state: FakeState = { feedback: [], users }
+    const app = await buildApp({ db: fakeDb(state), logger: false })
+    const res = await app.inject({
+      method: 'POST',
+      url: '/feedback',
+      headers: auth(AUTHOR, COMPANY_A),
+      payload: { recipientId: RECIPIENT, body: 'Hi', companyId: COMPANY_B, authorId: COLLEAGUE }
+    })
+    expect(res.statusCode).toBe(201)
+    expect(state.feedback[0]).toMatchObject({ company_id: COMPANY_A, author_id: AUTHOR })
+  })
+
+  it('returns 404 when the recipient belongs to another company', async () => {
+    const state: FakeState = { feedback: [], users }
+    const app = await buildApp({ db: fakeDb(state), logger: false })
+    const res = await app.inject({
+      method: 'POST',
+      url: '/feedback',
+      headers: auth(AUTHOR, COMPANY_B),
+      payload: { recipientId: RECIPIENT, body: 'Hi' }
+    })
+    expect(res.statusCode).toBe(404)
+    expect(state.feedback).toHaveLength(0)
+  })
+})
